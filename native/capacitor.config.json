{
  "appId": "in.est.surveillance",
  "appName": "EST",
  "webDir": "www",
  "server": { "androidScheme": "https", "iosScheme": "https" },
  "android": { "allowMixedContent": false, "backgroundColor": "#0d2018" },
  "ios": { "contentInset": "automatic", "backgroundColor": "#0d2018" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1200, "launchAutoHide": true, "backgroundColor": "#0d2018", "showSpinner": false, "androidScaleType": "CENTER_CROP", "splashImmersive": true },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0d2018", "overlaysWebView": false }
  }
}
